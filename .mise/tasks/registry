#!/usr/bin/env python3
#MISE description="Run the platform's registry: `registry token` gives it and its writers the write token, `registry import` loads the nodes and the apps' placements into it once, each with --dry-run"
"""The operator's half of the platform's registry. See spec/architecture/registry.md and RFC ja5hm.

`token` writes the registry's write token on every node it runs on, made and kept in secrets.json
the first time, and gives each writer the token, the cores to write to and every source host deploys
from; `import` reads infra's nodes.toml and puts each node into the registry, then puts
where each app runs, from every repository host deploys from, held to the revision it read, which is
safe to run again. Values move over SSH on stdin, never on a command line, and `--dry-run` touches
no machine and prints no secret. It borrows the database task's helpers rather than copying them.
"""

import ast
import importlib.machinery
import importlib.util
import json
import os
import shlex
import subprocess
import sys
import tomllib
import urllib.error
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent


def borrow(name):
	"""A sibling task, which has no extension, loaded as a module; its `main` stays unrun."""
	loader = importlib.machinery.SourceFileLoader(f"task_{name}", str(HERE / name))
	module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
	loader.exec_module(module)
	return module


database = borrow("database")
# The workspace this repository is cloned into, where repos.toml says which directory is which.
WORKSPACE = database.REPOS.parent
# The bookmark every source's declarations are read at: what is committed, not what is checked out.
MAIN = "main"

APP = "registry"
PORT = 12013
TOKEN = "REGISTRY_TOKEN"
# Who a change is recorded as made by.
BY = "import"
TIMEOUT_SECONDS = 10
# The apps that write to the registry while they run, each on the nodes its service.toml places it:
# the deployer, recording each app's release from every run it takes -- RFC jln34. Each is given
# the token, the cores as `REGISTRY`, and every source host deploys from added to its own
# `DEPLOY_SOURCES`, so no app host runs is left without a release.
WRITERS = ("deployer",)
# The variables a writer is told, in its config.env.
CORES = "REGISTRY"
SOURCES = "DEPLOY_SOURCES"


def fail(message):
	sys.exit(f"{APP}: {message}")


def placements():
	"""The core nodes the registry runs on, in order, from its service.toml."""
	return database.manifest_of(APP)["placements"]


def request_body(table, address, by=BY):
	"""The body of `PUT /nodes/<name>`: the node's table as nodes.toml has it, plus its tailnet
	IPv4. See spec/architecture/registry.md."""
	return {"by": by, "node": {**table, "address": address}}


def widened(current, wanted):
	"""The sources `current` names, in its order, then each of `wanted` it does not, each once."""
	have = list(dict.fromkeys(current.split()))
	return " ".join(have + [source for source in wanted if source not in have])


def configured(node, app, key):
	"""`key` as /data/apps/<app>/config.env on `node` sets it, '' when it sets none; None when the
	node could not be asked."""
	path = shlex.quote(f"/data/apps/{app}/config.env")
	return database.ssh(node, f"if [ -f {path} ]; then sed -n 's/^{key}=//p' {path}; fi")


def wire(node, writer, value, cores, sources, dry):
	"""Give `writer` on `node` the token in its secret.env, and in its config.env the cores and its
	own sources widened by `sources`, keeping every other line."""
	where = f"/data/apps/{writer}"
	if dry:
		print(f"{APP}: {node}: would set in {where}/secret.env: {TOKEN}=<redacted>")
		print(f"{APP}: {node}: would set in {where}/config.env: {CORES}={cores}")
		print(
			f"{APP}: {node}: would set in {where}/config.env: {SOURCES}=<what it names>, then each of"
			f" {' '.join(sources)} it does not"
		)
		return
	current = configured(node, writer, SOURCES)
	if current is None:
		fail(f"reading {SOURCES} of {writer} failed on {node}")
	if not database.upsert(node, writer, "secret.env", {TOKEN: value}):
		fail(f"writing {TOKEN} for {writer} failed on {node}")
	pairs = {CORES: cores, SOURCES: widened(current, sources)}
	if not database.upsert(node, writer, "config.env", pairs):
		fail(f"writing {CORES} and {SOURCES} for {writer} failed on {node}")


def token(dry):
	cores = placements()
	value = database.stored_secret(TOKEN, dry)
	for node in cores:
		if dry:
			print(
				f"{APP}: {node}: would set, keeping every other line, mode 600, in"
				f" /data/apps/{APP}/secret.env: {TOKEN}=<redacted>"
			)
		elif not database.upsert(node, APP, "secret.env", {TOKEN: value}):
			fail(f"writing {TOKEN} failed on {node}")
	addresses = " ".join(database.tailnet_ipv4(core) for core in cores)
	sources = host_sources()
	for writer in WRITERS:
		for node in database.manifest_of(writer)["placements"]:
			wire(node, writer, value, addresses, sources, dry)
	for app in (APP, *WRITERS):
		redeploy = f"mise run //repos/infra:node redeploy <node> {app}"
		print(f"{APP}: {app} reads it on its next deploy; `{redeploy}`")


def is_node_name(name):
	"""Three lowercase ASCII letters, as the registry's node.rs holds a node's name."""
	if not isinstance(name, str):
		return False
	return len(name) == 3 and name.isascii() and name.isalpha() and name.islower()


def placed(declaration):
	"""The nodes a service.toml places its app on, or None where the registry keeps none: a Worker's
	`["workers"]`, an empty list, or anything not a list of node names."""
	placements = declaration.get("placements")
	if not isinstance(placements, list) or not placements:
		return None
	return placements if all(is_node_name(node) for node in placements) else None


def apps_placed(declarations):
	"""Each app's name and where it is placed, None where it is not for the registry, from
	(path, declaration) pairs in order; one name declared twice fails, naming both."""
	seen = {}
	apps = []
	for path, declaration in declarations:
		name = declaration.get("name")
		if not isinstance(name, str) or not name:
			fail(f"{path} names no app")
		if name in seen:
			fail(f"{name} is declared twice, in {seen[name]} and {path}")
		seen[name] = path
		apps.append((name, placed(declaration)))
	return apps


def deploy_sources(text):
	"""Each `owner/repo` that DEPLOY_SOURCES in infra's node task names, read from its source rather
	than run, since running it would load that task's own imports."""
	for statement in ast.parse(text).body:
		if not isinstance(statement, ast.Assign):
			continue
		names = [target.id for target in statement.targets if isinstance(target, ast.Name)]
		value = statement.value
		is_text = isinstance(value, ast.Constant) and isinstance(value.value, str)
		if "DEPLOY_SOURCES" in names and is_text:
			return [entry.split("=")[0] for entry in value.value.split()]
	fail("infra's .mise/tasks/node holds no DEPLOY_SOURCES string")


def checkouts(sources, repos, root):
	"""Each source's checkout under `root`, in the directory repos.toml keys `owner:repo` by. One with
	no entry or no checkout fails: its apps would be left out, and every one of them read as drift."""
	directories = {spec: directory for directory, spec in repos.items()}
	found = []
	for source in sources:
		directory = directories.get(source.replace("/", ":", 1))
		if directory is None:
			fail(f"host deploys from {source}, and repos.toml names no directory for it")
		path = root / directory
		if not path.is_dir():
			fail(f"host deploys from {source}, and it is not cloned at {path}")
		found.append(path)
	return found


def jj(root, *arguments):
	"""What jj printed, run in the checkout at `root`, failing with what it said. It never snapshots
	the working copy, which may hold another session's work in progress."""
	ran = subprocess.run(
		["jj", "--ignore-working-copy", "-R", str(root), *arguments],
		cwd=root,
		text=True,
		capture_output=True,
	)
	if ran.returncode != 0:
		said = ran.stderr.strip().splitlines()
		fail(f"jj {' '.join(arguments)} in {root}: {said[0] if said else f'exit {ran.returncode}'}")
	return ran.stdout


def committed(root, path):
	"""`path` as `main` holds it in the checkout at `root`."""
	return jj(root, "file", "show", "-r", MAIN, path)


def host_sources(workspace=None):
	"""Every repository host deploys from, as `owner/repo`, in the order DEPLOY_SOURCES names them
	on infra's `main`."""
	infra = (workspace or WORKSPACE) / "repos/infra"
	if not infra.is_dir():
		fail(f"{infra} is not there; clone infra beside this repository")
	return deploy_sources(committed(infra, ".mise/tasks/node"))


def source_roots(workspace=None):
	"""The checkout of every repository host deploys from, in the order DEPLOY_SOURCES names them
	on infra's `main`."""
	workspace = workspace or WORKSPACE
	sources = host_sources(workspace)
	listed = workspace / "repos.toml"
	if not listed.is_file():
		fail(f"{listed} is not there; it says which directory each repository is cloned in")
	repos = tomllib.loads(listed.read_text())["repos"]
	return checkouts(sources, repos, workspace / "repos")


def declarations(roots):
	"""Every service.toml under each root's apps/ on its `main`, at any depth, since cue keeps its
	one level up. What is committed, never the working tree: an app another session has not
	committed is not yet anybody's to place."""
	for root in roots:
		listed = jj(root, "file", "list", "-r", MAIN, 'root-glob:"apps/**/service.toml"')
		for path in sorted(listed.splitlines()):
			if {"node_modules", "target"}.isdisjoint(Path(path).parts):
				yield root / path, tomllib.loads(committed(root, path))


def app_body(revision, placements, by=BY):
	"""The body of `PUT` or `PATCH /v1/apps/<name>`: who, the revision read, and the placements.
	See RFC cpc2b."""
	return {"by": by, "revision": revision, "spec": {"placements": placements}}


def call(address, method, path, body=None, secret=None):
	"""The registry's envelope at `address`, an error's as much as a success's; None when it did not
	answer at all."""
	headers = {"Content-Type": "application/json"}
	if secret:
		headers["Authorization"] = f"Bearer {secret}"
	request = urllib.request.Request(
		f"http://{address}:{PORT}{path}",
		data=None if body is None else json.dumps(body).encode(),
		method=method,
		headers=headers,
	)
	try:
		with urllib.request.urlopen(request, timeout=TIMEOUT_SECONDS) as answer:
			return json.load(answer)
	except urllib.error.HTTPError as refused:
		text = refused.read().decode().strip()
		try:
			return json.loads(text)
		except ValueError:
			fail(f"{method} {path}: refused: {refused.code} {text}")
	except (OSError, ValueError):
		return None


def answered(addresses, method, path, body=None, secret=None):
	"""The first answer of the registries at `addresses`, in order."""
	for address in addresses:
		answer = call(address, method, path, body, secret)
		if answer is not None:
			return answer
	fail(f"no registry answered {method} {path}")


def method_at(revision):
	"""`PUT` for an app the registry does not hold, at revision 0; `PATCH` for one it does, which
	sets its placements and keeps its release, written by the hook -- RFC jln34."""
	return "PUT" if revision == 0 else "PATCH"


def revision_of(answer, name):
	"""The revision `GET /v1/apps/<name>` answered, 0 for an app it does not hold."""
	if answer.get("status") == "success":
		return answer["data"]["revision"]
	if answer.get("code") == "no_such_resource":
		return 0
	fail(f"app {name}: {answer}")


def load_nodes():
	path = database.NODES
	if not path.is_file():
		fail(f"{path} is not there; clone infra beside this repository")
	return tomllib.loads(path.read_text())


def importing(dry):
	nodes = load_nodes()
	cores = placements()
	secret = os.environ.get(TOKEN)
	if not secret and not dry:
		fail(f"secrets.json has no {TOKEN}; `registry token` makes it")
	apps = apps_placed(declarations(source_roots()))
	addresses = {node: database.tailnet_ipv4(node) for node in {*nodes, *cores}}
	registries = [addresses[core] for core in cores]
	if dry:
		print(
			f"{APP}: would PUT each of {len(nodes)} nodes, by {BY!r}, to the first of"
			f" {', '.join(cores)} whose registry answers on {PORT}, as Bearer <redacted>:"
		)
		for name, table in nodes.items():
			body = request_body(table, addresses[name])
			print(f"  PUT /nodes/{name} {json.dumps(body)}")
		print(
			f"{APP}: then each app placed on nodes, at the revision GET /v1/apps/<name> answers,"
			" by PATCH, or by PUT where the registry does not hold it:"
		)
		for name, where in apps:
			if where is None:
				print(f"  skip {name}")
			else:
				body = app_body("<read>", where)
				print(f"  PATCH /v1/apps/{name} {json.dumps(body)}")
		return
	for name, table in nodes.items():
		body = request_body(table, addresses[name])
		answer = answered(registries, "PUT", f"/nodes/{name}", body, secret)
		if answer.get("status") != "success":
			fail(f"{name}: {answer}")
		change = answer["data"].get("change")
		print(f"{APP}: {name}: " + ("unchanged" if change is None else f"changed, change {change}"))
	for name, where in apps:
		if where is None:
			print(f"{APP}: app {name}: skipped, not placed on nodes")
			continue
		revision = revision_of(answered(registries, "GET", f"/v1/apps/{name}"), name)
		body = app_body(revision, where)
		answer = answered(registries, method_at(revision), f"/v1/apps/{name}", body, secret)
		if answer.get("status") != "success":
			fail(f"app {name}: {answer}")
		made = answer["data"].get("revision")
		print(f"{APP}: app {name}: " + ("unchanged" if made is None else f"changed, revision {made}"))


def main():
	arguments = sys.argv[1:]
	dry = "--dry-run" in arguments or "-n" in arguments
	rest = [a for a in arguments if a not in ("--dry-run", "-n")]
	if len(rest) != 1 or rest[0] not in ("token", "import"):
		fail("name one of token or import, and --dry-run to only say what")
	(token if rest[0] == "token" else importing)(dry)


if __name__ == "__main__":
	main()
